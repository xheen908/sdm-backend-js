<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NFC Developer 2 — SUN Verification</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #0A0B10;
      --card-bg: rgba(22, 24, 34, 0.6);
      --card-border: rgba(37, 41, 58, 0.8);
      --accent-blue: #3B82F6;
      --accent-green: #00FF66;
      --accent-red: #EF4444;
      --accent-orange: #F97316;
      --text-main: #FFFFFF;
      --text-muted: #8A8F9E;
      --text-dim: #5A5E73;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient background glow */
    body::before {
      content: '';
      position: absolute;
      top: -20%;
      left: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, rgba(0, 0, 0, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    body::after {
      content: '';
      position: absolute;
      bottom: -10%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(0, 255, 102, 0.05) 0%, rgba(0, 0, 0, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .container {
      width: 100%;
      max-width: 600px;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      z-index: 10;
      animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    header {
      text-align: center;
      margin-bottom: 36px;
    }

    .logo-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(0, 255, 102, 0.1);
      border: 2px solid var(--accent-green);
      box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
      margin-bottom: 16px;
      animation: pulseGreen 2s infinite ease-in-out;
    }

    @keyframes pulseGreen {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
      }
      50% {
        transform: scale(1.05);
        box-shadow: 0 0 30px rgba(0, 255, 102, 0.4);
      }
    }

    .logo-icon {
      font-size: 28px;
    }

    h1 {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
      background: linear-gradient(135deg, #FFFFFF 0%, #D1D5DB 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .subtitle {
      font-size: 14px;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Info list */
    .info-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 32px;
    }

    .info-item {
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: rgba(31, 34, 49, 0.4);
      border: 1px solid rgba(47, 52, 77, 0.5);
      border-radius: 16px;
      padding: 16px 20px;
      transition: all 0.3s ease;
    }

    .info-item:hover {
      background: rgba(31, 34, 49, 0.6);
      border-color: rgba(59, 130, 246, 0.3);
      transform: translateY(-2px);
    }

    .info-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .info-value {
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .monospace {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      color: var(--accent-green);
      letter-spacing: -0.2px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-aes {
      background: rgba(59, 130, 246, 0.15);
      color: #60A5FA;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .badge-lrp {
      background: rgba(139, 92, 246, 0.15);
      color: #A78BFA;
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    /* Terminal terminal-block */
    .terminal-block {
      background: #0D0E15;
      border: 1px solid rgba(47, 52, 77, 0.8);
      border-radius: 12px;
      padding: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      color: #00FF66;
      overflow-x: auto;
      white-space: pre-wrap;
      line-height: 1.6;
    }

    /* Copy button */
    .copy-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 4px;
      font-weight: 600;
      transition: color 0.2s;
    }

    .copy-btn:hover {
      color: #FFFFFF;
    }

    /* Tamper loop status */
    .status-card {
      display: flex;
      align-items: center;
      gap: 16px;
      border-radius: 16px;
      padding: 18px 24px;
      margin-top: 10px;
      border: 1px solid transparent;
    }

    .status-card.green {
      background: rgba(0, 255, 102, 0.08);
      border-color: rgba(0, 255, 102, 0.15);
      color: var(--accent-green);
    }

    .status-card.red {
      background: rgba(239, 68, 68, 0.08);
      border-color: rgba(239, 68, 68, 0.15);
      color: var(--accent-red);
    }

    .status-card.orange {
      background: rgba(249, 115, 22, 0.08);
      border-color: rgba(249, 115, 22, 0.15);
      color: var(--accent-orange);
    }

    .status-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: inline-block;
    }

    .green .status-dot {
      background-color: var(--accent-green);
      box-shadow: 0 0 10px var(--accent-green);
    }

    .red .status-dot {
      background-color: var(--accent-red);
      box-shadow: 0 0 10px var(--accent-red);
    }

    .orange .status-dot {
      background-color: var(--accent-orange);
      box-shadow: 0 0 10px var(--accent-orange);
    }

    .status-text {
      font-size: 15px;
      font-weight: 700;
    }

    footer {
      margin-top: 36px;
      text-align: center;
      font-size: 11px;
      color: var(--text-dim);
      font-weight: 600;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .demo-badge {
      display: inline-block;
      margin-top: 8px;
      background: rgba(249, 115, 22, 0.15);
      color: var(--accent-orange);
      border: 1px solid rgba(249, 115, 22, 0.3);
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <div class="logo-container">
        <span class="logo-icon">🔒</span>
      </div>
      <h1>NFC Developer 2</h1>
      <div class="subtitle">Secure Unique NFC (SUN) Verification Success</div>
      <% if (demoMode) { %>
        <div class="demo-badge">⚙️ Default Zero Keys</div>
      <% } %>
    </header>

    <div class="info-list">
      <!-- Tag UID -->
      <div class="info-item">
        <div class="info-label">Tag UID (Unique Identifier)</div>
        <div class="info-value">
          <span class="monospace" id="tagUid"><%= uid %></span>
          <button class="copy-btn" onclick="copyUid()">
            <span id="copyText">📋 Copy</span>
          </button>
        </div>
      </div>

      <!-- Encryption Mode -->
      <div class="info-item">
        <div class="info-label">Encryption Protocol</div>
        <div class="info-value">
          <span>AES-128 (Secure Messaging)</span>
          <span class="badge badge-aes"><%= encryptionMode %></span>
        </div>
      </div>

      <!-- Read Counter -->
      <div class="info-item">
        <div class="info-label">SDM Scan Counter</div>
        <div class="info-value">
          <span>Taps Count</span>
          <span style="color: var(--accent-blue); font-size: 20px; font-weight: 800;"><%= readCtrNum %></span>
        </div>
      </div>

      <!-- Decrypted File Content -->
      <% if (fileDataUtf8) { %>
        <div class="info-item">
          <div class="info-label">Decrypted File Content</div>
          <div class="terminal-block"><%= fileDataUtf8 %></div>
        </div>
      <% } else if (fileData) { %>
        <div class="info-item">
          <div class="info-label">Decrypted File Hex</div>
          <div class="terminal-block"><%= fileData %></div>
        </div>
      <% } %>

      <!-- Tamper loop status -->
      <% if (ttStatus) { %>
        <div class="info-label" style="margin-left: 20px; margin-bottom: -10px;">Tamper Detection Loop</div>
        <div class="status-card <%= ttColor %>">
          <span class="status-dot"></span>
          <span class="status-text"><%= ttStatus %></span>
        </div>
      <% } %>
    </div>
  </div>

  <footer>
    NFC Developer Backend • Powered by Node.js
  </footer>

  <script>
    function copyUid() {
      const uidText = document.getElementById('tagUid').innerText;
      navigator.clipboard.writeText(uidText).then(() => {
        const copyTextBtn = document.getElementById('copyText');
        copyTextBtn.innerText = '✅ Copied!';
        setTimeout(() => {
          copyTextBtn.innerText = '📋 Copy';
        }, 2000);
      });
    }
  </script>
</body>
</html>
