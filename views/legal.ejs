<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — OCPP Labs</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #0A0B10;
      --card-bg: rgba(22, 24, 34, 0.6);
      --card-border: rgba(37, 41, 58, 0.8);
      --accent-blue: #3B82F6;
      --accent-green: #00FF66;
      --text-main: #FFFFFF;
      --text-muted: #8A8F9E;
      --text-dim: #5A5E73;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 24px;
      position: relative;
      line-height: 1.6;
    }

    /* Ambient background glow */
    body::before {
      content: '';
      position: absolute;
      top: -20%;
      left: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
      pointer-events: none;
      z-index: 1;
    }

    .container {
      width: 100%;
      max-width: 800px;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      z-index: 10;
      margin-bottom: 40px;
    }

    header {
      text-align: center;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .logo-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid var(--accent-blue);
      margin-bottom: 16px;
    }

    h1 {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #FFFFFF 0%, #D1D5DB 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 8px;
    }

    .content-block h2 {
      color: #FFFFFF;
      font-size: 20px;
      font-weight: 700;
      margin-top: 32px;
      margin-bottom: 12px;
      border-left: 3px solid var(--accent-blue);
      padding-left: 12px;
    }

    .content-block p {
      color: var(--text-muted);
      font-size: 15px;
      margin-bottom: 16px;
    }

    .content-block ul {
      margin-left: 20px;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .content-block li {
      margin-bottom: 8px;
    }

    .highlight-box {
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(59, 130, 246, 0.2);
      padding: 20px;
      border-radius: 16px;
      margin: 24px 0;
    }

    footer {
      text-align: center;
      font-size: 12px;
      color: var(--text-dim);
      margin-top: auto;
    }
    
    a {
      color: var(--accent-blue);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <div class="logo-container">
        <span style="font-size: 22px;">⚖️</span>
      </div>
      <h1><%= title %></h1>
      <div style="color: var(--text-muted); font-size: 14px; font-weight: 600;">OCPP Labs Security & Architecture</div>
    </header>

    <div class="content-block">
      <%- content %>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> OCPP Labs. All rights reserved.
    <div style="margin-top: 8px;">
       <a href="/">Home</a> &bull; 
       <a href="/privacy">Privacy Policy</a> &bull; 
       <a href="/imprint">Imprint</a>
    </div>
  </footer>

</body>
</html>
